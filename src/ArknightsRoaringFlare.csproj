<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>ArknightsRoaringFlare</AssemblyName>
    <RootNamespace>ArknightsRoaringFlare</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <RoaringFlareSts2Target Condition="'$(RoaringFlareSts2Target)' == ''">0.111.0</RoaringFlareSts2Target>
    <SteamAppsDir Condition="'$(SteamAppsDir)' == ''">$(HOME)/Library/Application Support/Steam/steamapps</SteamAppsDir>
    <!-- 游戏程序集：开发工作区里按版本存档的引用优先（可跨版本构建），没有时用本机游戏安装目录；也可以直接传 GameDataDir。 -->
    <VersionedRefsRoot Condition="'$(VersionedRefsRoot)' == ''">$(MSBuildThisFileDirectory)../../HextechRunes/versioned-dll-backups</VersionedRefsRoot>
    <GameDataDir Condition="'$(GameDataDir)' == '' And Exists('$(VersionedRefsRoot)/$(RoaringFlareSts2Target)/game-refs')">$(VersionedRefsRoot)/$(RoaringFlareSts2Target)/game-refs</GameDataDir>
    <GameDataDir Condition="'$(GameDataDir)' == ''">$(SteamAppsDir)/common/Slay the Spire 2/SlayTheSpire2.app/Contents/Resources/data_sts2_macos_arm64</GameDataDir>
    <!-- 前置 RitsuLib（幕、遭遇战、怪物、能力都经它注册）；引用取创意工坊安装目录里与目标游戏版本对应的 compat 变体。 -->
    <RitsuLibRoot Condition="'$(RitsuLibRoot)' == ''">$(SteamAppsDir)/workshop/content/2868840/3747602295</RitsuLibRoot>
    <RitsuLibReferenceTarget>$(RoaringFlareSts2Target)</RitsuLibReferenceTarget>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="sts2">
      <HintPath>$(GameDataDir)/sts2.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="GodotSharp">
      <HintPath>$(GameDataDir)/GodotSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDataDir)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Import Project="$(RitsuLibRoot)/RitsuLib.References.props" />
</Project>
